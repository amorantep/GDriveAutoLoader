# Copy this to .env and fill in your values
# Get credentials from Google Cloud Console > APIs & Services > Credentials
GOOGLE_CLIENT_ID=your_client_id_here
GOOGLE_CLIENT_SECRET=your_client_secret_here
# The redirect URI must match what you configured in Google Cloud Console
REDIRECT_URI=http://localhost:8000/auth/callback
# Upload delay between files in milliseconds (default 500)
DEFAULT_UPLOAD_DELAY_MS=500
